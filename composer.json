{
    "name": "eor_bah545/payments",
    "description": "Bibliothèque PHP unifiée pour encapsuler plusieurs fournisseurs de paiement : PayPal, Stripe, Visa Direct, Orange Money (Guinée) et PayCard (Guinée).",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "paypal", "stripe", "visa", "orange money", "paycard", "guinee", "mobile money"],
    "authors": [
        {
            "name": "EORBAH",
            "email": "eor.bah545@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "stripe/stripe-php": "^15.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
